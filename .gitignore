# 依存関係
node_modules/
.pnpm-store/

# ビルド成果物
dist/
build/
.expo/
.next/
# apps/landing + apps/app の web export を合成した公開ディレクトリ
# （scripts/build-public.mjs が生成する。デプロイ時に作り直す）
apps/api/public/

# Cloudflare
.wrangler/

# 秘密情報（絶対にコミットしない）
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
!.dev.vars.example

# wrangler types が生成するランタイム型（各自 `wrangler types` で再生成する）
worker-configuration.d.ts

# ログ・一時ファイル
*.log
npm-debug.log*
coverage/
*.tsbuildinfo
# artifacts配下の動作証跡ログは対象外（conventions.md 8節）
!artifacts/**/*.log

# OS
.DS_Store
Thumbs.db
desktop.ini
