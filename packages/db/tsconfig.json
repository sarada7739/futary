{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["@cloudflare/workers-types", "node"],
    // seed/run.ts はNodeがネイティブに.tsを実行する前提のCLIで、拡張子付きの
    // 相対importが要る（Node ESMは拡張子を省略できない）。tsc側は--noEmit
    // （type-checkスクリプト）なのでこのフラグを有効化できる
    "allowImportingTsExtensions": true
  },
  "include": ["src", "seed"]
}
