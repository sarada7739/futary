{
  "name": "@futary/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "wrangler types",
    "dev": "wrangler dev",
    "pretype-check": "wrangler types",
    "type-check": "tsc --noEmit",
    "predeploy": "node ../../scripts/build-public.mjs",
    "deploy": "wrangler deploy",
    "pretest": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "r2:cors:apply": "wrangler r2 bucket cors set futary-images --file r2-cors.json",
    "r2:cors:list": "wrangler r2 bucket cors list futary-images"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.2",
    "@futary/contract": "workspace:*",
    "@futary/date": "workspace:*",
    "@futary/db": "workspace:*",
    "@orpc/contract": "1.15.0",
    "@orpc/server": "1.15.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.2",
    "hono": "^4.13.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.0",
    "@orpc/client": "1.15.0",
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
