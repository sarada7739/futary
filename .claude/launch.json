{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@futary/app", "run", "web"],
      "port": 8081
    },
    {
      "name": "api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@futary/api", "run", "dev"],
      "port": 8787
    },
    {
      "name": "api-dev-remote",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@futary/api", "exec", "wrangler", "dev", "--remote"],
      "port": 8787
    }
  ]
}
